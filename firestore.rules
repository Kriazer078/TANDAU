rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🏫 УНИВЕРСИТЕТЫ
    // Читать могут все.
    // Обновлять счетчики (лайки/рейтинг) могут авторизованные пользователи.
    // Создавать/удалять вузы - НИКТО (только админ через консоль Firebase).
    match /universities/{universityId} {
      allow read: if true;
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['likesCount', 'reviewsCount', 'averageRating']);
    }

    // ❤️ ЛАЙКИ
    // ID документа ОБЯЗАН быть в формате: userId_universityId
    match /likes/{likeId} {
      allow read: if request.auth != null;
      
      // Создать лайк можно только для себя
      allow create: if request.auth != null 
                    && likeId == request.auth.uid + '_' + request.resource.data.universityId;
      
      // Удалить лайк можно только свой
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }

    // ⭐ ОТЗЫВЫ
    match /reviews/{reviewId} {
      allow read: if true;
      
      // Создать отзыв: только авторизованный, валидный рейтинг (1-5)
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment.size() < 1000;
                    
      // Удалить/изменить: только свой отзыв
      allow update, delete: if request.auth != null 
                            && resource.data.userId == request.auth.uid;
    }
    
    // 👤 ПОЛЬЗОВАТЕЛИ
    match /users/{userId} {
      // 1. ЧИТАТЬ профили может любой авторизованный пользователь
      // (полезно для социальных функций, списка друзей и т.д.)
      allow read: if request.auth != null;

      // 2. ИЗМЕНЯТЬ (создавать, обновлять, удалять) профиль может ТОЛЬКО владелец
      // (ID документа должен совпадать с UID пользователя)
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 📊 СРАВНЕНИЯ (если есть коллекция comparisons)
    match /comparisons/{docId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
  
  