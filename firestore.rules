rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════
    // 🛡️ HELPER FUNCTIONS (PRO)
    // ═══════════════════════════════════════

    // Проверка прав администратора (Short-circuit optimization)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nurdauletabutalip02@gmail.com' ||
        request.auth.token.email == 'orazhannurik00@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    // Проверка авторизации
    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка на бан (Предотвращает запись для забаненных)
    function isNotBanned() {
      return !isSignedIn() || 
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    // Стандартные права для записи (Авторизован + Не забанен)
    function isAuth() {
      return isSignedIn() && isNotBanned();
    }

    // Владелец документа
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════
    // 🏫 УНИВЕРСИТЕТЫ
    // ═══════════════════════════════════════
    match /universities/{universityId} {
      allow read: if true;
      // Пользователи могут обновлять только статистику. 
      // В идеале это должно быть в Cloud Functions, но для текущей архитектуры оставляем так.
      allow update: if isAuth() 
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['likesCount', 'reviewsCount', 'averageRating']);
      allow create, delete: if isAdmin();
    }

    // ═══════════════════════════════════════
    // ❤️ ЛАЙКИ
    // ═══════════════════════════════════════
    match /likes/{likeId} {
      allow read: if isSignedIn();
      // Enforce ID format: userId_universityId
      allow create: if isAuth() 
                    && likeId == request.auth.uid + '_' + request.resource.data.universityId
                    && request.resource.data.userId == request.auth.uid;
      // Удалять может только владелец или админ
      allow delete: if isAuth() 
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ═══════════════════════════════════════
    // ⭐ ОТЗЫВЫ
    // ═══════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;
      // Ограничения на создание: валидный рейтинг и длина комментария
      allow create: if isAuth() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment.size() < 1500;
      // Запрет на смену автора или университета при редактировании
      allow update: if isAuth() 
                    && resource.data.userId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['userId', 'universityId', 'createdAt']);
      allow delete: if isAuth() 
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ═══════════════════════════════════════
    // 👤 ПОЛЬЗОВАТЕЛИ
    // ═══════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // При создании нельзя сразу стать админом или снять бан
      allow create: if isOwner(userId)
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('banned', false) == false;
      
      allow update: if (
        isOwner(userId) && isNotBanned() &&
        // Пользователь не может сам менять свою роль или статус бана
        !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'banned', 'banReason'])
      ) || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();

      // 🔔 УВЕДОМЛЕНИЯ
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        // Создавать уведомления может админ или сам пользователь (для системных/локальных синхронизаций)
        allow create, update: if isAdmin() || (isAuth() && isOwner(userId));
      }
    }
    
    // ═══════════════════════════════════════
    // 📊 СРАВНЕНИЯ
    // ═══════════════════════════════════════
    match /comparisons/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAuth() && (
        (request.resource.data.get('userId', '') == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // ═══════════════════════════════════════
    // 🎁 ПРОМОКОДЫ
    // ═══════════════════════════════════════
    match /promo_codes/{codeId} {
      allow read: if isSignedIn();
      allow update: if isAuth(); // transactions allow users to increment them
      allow create, delete: if isAdmin();
    }

    // ═══════════════════════════════════════
    // 🛡️ АДМИН-ДОСТУП КО ВСЕМУ (CATCH-ALL)
    // ═══════════════════════════════════════
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}