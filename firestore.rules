rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════

    // Check if the current user is an admin (has role='admin' in their user document)
    function isAdmin() {
      return request.auth != null 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════
    // 🏫 УНИВЕРСИТЕТЫ
    // ═══════════════════════════════════════
    // Читать могут все.
    // Обновлять счетчики (лайки/рейтинг) могут авторизованные пользователи.
    // Создавать/удалять вузы — только админ.
    match /universities/{universityId} {
      allow read: if true;
      allow update: if isSignedIn() 
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['likesCount', 'reviewsCount', 'averageRating']);
      allow create, delete: if isAdmin();
    }

    // ═══════════════════════════════════════
    // ❤️ ЛАЙКИ
    // ═══════════════════════════════════════
    // ID документа ОБЯЗАН быть в формате: userId_universityId
    match /likes/{likeId} {
      allow read: if isSignedIn();
      
      // Создать лайк можно только для себя
      allow create: if isSignedIn() 
                    && likeId == request.auth.uid + '_' + request.resource.data.universityId;
      
      // Удалить лайк можно только свой
      allow delete: if isSignedIn() 
                    && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════
    // ⭐ ОТЗЫВЫ
    // ═══════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;
      
      // Создать отзыв: только авторизованный, валидный рейтинг (1-5), ограничение длины
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment.size() < 1000;
                    
      // Изменить: только автор отзыва
      allow update: if isSignedIn() 
                    && resource.data.userId == request.auth.uid;

      // Удалить: автор или админ
      allow delete: if isSignedIn() 
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ═══════════════════════════════════════
    // 👤 ПОЛЬЗОВАТЕЛИ
    // ═══════════════════════════════════════
    match /users/{userId} {
      // Читать профили могут все (чтобы видеть ник/фото)
      allow read: if true;
      
      // Создать свой профиль (при регистрации)
      allow create: if isOwner(userId);

      // Обновить свой профиль (но нельзя менять role самому!)
      allow update: if isOwner(userId) 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      // Админ может менять role (для назначения других админов)
      allow update: if isAdmin();

      // Удалить свой профиль
      allow delete: if isOwner(userId) || isAdmin();

      // 🔔 УВЕДОМЛЕНИЯ (вложенная коллекция)
      match /notifications/{notificationId} {
        // Пользователь может читать/удалять свои уведомления
        allow read, delete: if isOwner(userId);
        // Писать может владелец ИЛИ админ (для отправки уведомлений)
        allow create, update: if isOwner(userId) || isAdmin();
      }
    }
    
    // ═══════════════════════════════════════
    // 📊 СРАВНЕНИЯ
    // ═══════════════════════════════════════
    match /comparisons/{docId} {
      allow read, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}