rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ═══════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isNotBanned() {
      return !isSignedIn() || 
             !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ||
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    // ═══════════════════════════════════════
    // USER STORAGE
    // ═══════════════════════════════════════
    match /users/{userId}/{allPaths=**} {
      // Любой может видеть фото (нужно для профилей других людей)
      allow read: if true;
      
      // Только владелец может загружать/менять, если он НЕ ЗАБАНЕН
      allow write: if isSignedIn() 
                   && request.auth.uid == userId 
                   && isNotBanned();
    }

    // ═══════════════════════════════════════
    // REVIEWS STORAGE
    // ═══════════════════════════════════════
    match /reviews/{imageId} {
      // Фото отзывов публичные
      allow read: if true;
      
      // Загружать могут только зарегистрированные и не забаненные
      // Ограничение: размер файла не более 5 МБ
      allow write: if isSignedIn() 
                   && isNotBanned()
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
